# Copia este archivo como .env.local y rellena con tus valores de Supabase.
# (Project Settings -> API en el panel de Supabase, o el botón "Connect")

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Opcional: URL pública de tu web (mejora la imagen al compartir el enlace).
# Ej. https://tu-tienda.vercel.app
# NEXT_PUBLIC_SITE_URL=
